{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM"],
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "./dist",
		"rootDir": "./",
		"baseUrl": "./",
		"types": ["node"],
		"allowImportingTsExtensions": false,
		"noEmit": false,
		"declaration": false,
		"sourceMap": true,
		"paths": {
			"@/*": ["src/*"],
			"@/config/*": ["src/config/*"],
			"@/controllers/*": ["src/controllers/*"],
			"@/middleware/*": ["src/middleware/*"],
			"@/models/*": ["src/models/*"],
			"@/routes/*": ["src/routes/*"],
			"@/services/*": ["src/services/*"],
			"@/utils/*": ["src/utils/*"],
			"@/types/*": ["src/types/*"],
			"@/schemas/*": ["src/schemas/*"],
			"@/scripts/*": ["src/scripts/*"],
			"@/tests/*": ["src/tests/*"]
		}
	},
	"include": ["src/**/*", "*.ts", "*.js", "prisma/**/*", "eslint.config.ts"],
	"exclude": ["node_modules", "dist"]
}
