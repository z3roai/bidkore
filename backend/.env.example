# ===================================================
# BidKore Backend Environment Variables
# ===================================================
# This file should be copied to .env and updated with your actual values
# cp .env.example .env

# ===================================================
# Application Configuration
# ===================================================
NODE_ENV=development
PORT=5000
BACKEND_PORT=5000
FRONTEND_PORT=3000

# ===================================================
# Database Configuration (PostgreSQL Container)
# ===================================================
# Container: bidkore-postgres
# Port: localhost:5432 (mapped from container port 5432)
DATABASE_URL=postgresql://bidkore:bidkore_password@localhost:5432/bidkore
POSTGRES_DB=bidkore
POSTGRES_USER=bidkore
POSTGRES_PASSWORD=bidkore_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===================================================
# Redis Configuration (Redis Container)
# ===================================================
# Container: bidkore-redis
# Port: localhost:6379 (mapped from container port 6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ===================================================
# Authentication & Security
# ===================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-16-chars
ALLOW_PASSWORDLESS_LOGIN=true

# ===================================================
# URLs & CORS
# ===================================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ===================================================
# Email Configuration (SendGrid)
# ===================================================
SENDGRID_API_KEY=
FROM_EMAIL=noreply@bidkore.com

# ===================================================
# Stripe Payment Configuration
# ===================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===================================================
# OAuth Providers
# ===================================================

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Dropbox Integration
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=

# ===================================================
# External Services
# ===================================================

# OpenAI API
OPENAI_API_KEY=

# SAM.gov API
SAM_API_KEY=
